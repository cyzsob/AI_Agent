# 复制此文件为 .env 并填入真实值（.env 已被 gitignore，不会提交）
DEEPSEEK_API_KEY=sk-xxxxx

# HuggingFace 镜像（国内网络访问 hf-mirror.com，重排模型首次下载必需）
HF_ENDPOINT=https://hf-mirror.com

# 数据库连接
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=xxxxx
DB_NAME=RAG_test

# Redis / 上下文记忆模块（短期记忆 + 异步持久化长期记忆到 PGVector）
REDIS_URL=redis://localhost:6379/0
SHORT_MEMORY_TTL=3600            # 短期记忆闲置过期时间（秒）
SHORT_MEMORY_MAX_MSGS=20         # 短期记忆保留的最大消息条数
MEMORY_DISTANCE_THRESHOLD=0.6    # 长期记忆余弦距离阈值，保证提取精度
MEMORY_RETRIEVAL_K=5             # 长期记忆混合检索 Top-K
MEMORY_LONG_ENABLED=true         # 长期记忆持久化总开关（关闭后仅保留 Redis 短期记忆）

# OpenWeatherMap
OPENWEATHERMAP_API_KEY=xxxxx

# 多模态视觉模型（用户上传图片理解，智谱 GLM-4V 云端接口）
# 在 https://open.bigmodel.cn 注册并创建 API Key
ZHIPU_API_KEY=xxxxx
# 默认使用免费模型 glm-4v-flash（无需充值）；付费 glm-4v-plus 需账号有余额
# GLM4V_MODEL=glm-4v-flash
# GLM4V_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
